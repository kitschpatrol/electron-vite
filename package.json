{
  "name": "@kitschpatrol/electron-vite",
  "version": "6.0.0-beta.4",
  "description": "Fork of electron-vite with hotfixes.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./node": {
      "types": "./node.d.ts"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "electron-vite": "bin/electron-vite.js"
  },
  "files": [
    "bin",
    "dist",
    "node.d.ts"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@11.13.0",
  "author": "Alex Wei<https://github.com/alex8088>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kitschpatrol/electron-vite.git"
  },
  "bugs": {
    "url": "https://github.com/kitschpatrol/electron-vite/issues"
  },
  "homepage": "https://github.com/kitschpatrol/electron-vite",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "electron",
    "vite",
    "cli",
    "plugin"
  ],
  "scripts": {
    "format": "mdat && prettier --write .",
    "lint": "eslint --cache .",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run lint && rollup -c rollup.config.ts --configPlugin typescript",
    "release": "bumpp --commit 'release: %s' && pnpm build && NPM_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish --tag latest"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpx lint-staged",
    "commit-msg": "node scripts/verifyCommit.js $1"
  },
  "lint-staged": {
    "*.js": [
      "prettier --write"
    ],
    "*.ts?(x)": [
      "eslint",
      "prettier --parser=typescript --write"
    ]
  },
  "peerDependencies": {
    "@swc/core": "^1.0.0",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "@swc/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.15.43",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.20.1",
    "bumpp": "^11.1.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "lint-staged": "^16.4.0",
    "mdat": "^2.3.6",
    "prettier": "^3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-rm": "^1.0.2",
    "simple-git-hooks": "^2.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^8.1.4"
  },
  "dependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-arrow-functions": "^7.29.7",
    "cac": "^7.0.0",
    "esbuild": "^0.25.12",
    "magic-string": "^0.30.21",
    "picocolors": "^1.1.1"
  }
}
